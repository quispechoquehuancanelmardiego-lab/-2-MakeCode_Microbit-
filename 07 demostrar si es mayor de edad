#practica 7
#realiza un programa que muestre un SMS 
#si la persona es mayor de edad 
edad=0
def on_button_pressed_b():
    global edad
    edad = randint(1 , 30)
    basic.show_number(edad)
    basic.pause(500)
    if edad >= 18:
      basic.show_string("MAYOR DE EDAD")
      basic.pause(500)
    else:
     basic.show_string(" MENOR DE EDAD")
     basic.pause(500)
    basic.clear_screen()
input.on_button_pressed(Button.B, on_button_pressed_b)
