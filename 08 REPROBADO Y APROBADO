#practica 8
#realiza un programa que muestre un SMS
#si la persona a reprobado la materia o aprobo la materia
nota=0
def on_button_pressed_a():
    global nota
    nota = randint(1 , 100)
    basic.show_number(nota)
    basic.pause(500)
    if nota >= 51:
      basic.show_icon(IconNames.YES)
      basic.show_string(" APROBASTE")
      basic.pause(500)
    else:
     basic.show_icon(IconNames.NO)
     basic.show_string(" REPROBASTE")
     basic.pause(500)
    basic.clear_screen()
input.on_button_pressed(Button.A, on_button_pressed_a)
