#practica 10
#realiza un programa que simule un medidor de velocidad
#usando numeros al azar y el boton B , en el lenguaje Python
#SI velocidad >= 70 muestre un SMS de "RAPIDO", SINO un SMS de "LENTO"
velocidad=0
def on_button_pressed_b():
    global velocidad
    velocidad = randint(1 , 200)
    basic.show_number(velocidad)
    basic.pause(500)
    if velocidad >= 70:
      basic.show_string(" RAPIDO!")
      basic.pause(500)
    else:
     basic.show_string(" LENTO")
     basic.pause(500)
    basic.clear_screen()
input.on_button_pressed(Button.B, on_button_pressed_b)
